# Carbon PebbleKit JS — build-time environment overrides
# Copy this file to .env and uncomment/edit values as needed.
# .env is gitignored and must never be committed to the repository.
#
# These values override the defaults in src/pkjs/constants.js at build time.
# Forks should set CARBON_SERVICE_STATUS_URL to point to their own copy of
# services.json so that they control their own service enablement.

# URL for the service status JSON file.
# Default: raw GitHub URL for this repo's services.json on the main branch.
#CARBON_SERVICE_STATUS_URL=https://raw.githubusercontent.com/yourfork/carbon/main/services.json

# Set to true to skip the remote service check entirely.
# The bundled local services.json snapshot will be used instead.
# Useful during offline development or if the remote URL is not reachable.
#CARBON_DISABLE_REMOTE_SERVICES=false
