{
  "name": "dwd-carbon",
  "description": "24-hour weather graph watchface for Pebble smartwatches, defaulting to the DWD weather source",
  "author": {
    "name": "Kai Timmer",
    "url": "https://github.com/kaitimmer/dwd-carbon"
  },
  "version": "1.5.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "pebble": {
    "displayName": "DWD Carbon",
    "uuid": "ce1f6e97-7229-41bb-97c6-69a2e786361a",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "diorite",
      "emery",
      "flint"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "location",
      "configurable"
    ],
    "messageKeys": [
      "WEATHER_REQUEST",
      "WEATHER_TEMP",
      "WEATHER_TEMP_HIGH",
      "WEATHER_TEMP_LOW",
      "WEATHER_CODE",
      "WEATHER_PRECIP_PROB",
      "WEATHER_TEMP_HOURLY",
      "WEATHER_APPARENT_TEMP_HOURLY",
      "WEATHER_CLOUD_COVER",
      "WEATHER_HOURLY_CODE",
      "WEATHER_SUNRISE_HOUR",
      "WEATHER_SUNSET_HOUR",
      "WEATHER_FETCH_TIME",
      "CITY_NAME",
      "SETTING_WEATHER_SOURCE",
      "SETTING_TEMP_UNIT",
      "SETTING_FETCH_INTERVAL",
      "SETTING_ACCENT_COLOR",
      "SETTING_DATE_FORMAT",
      "SETTING_BATTERY_DISPLAY",
      "SETTING_SHOW_TIMEZONE",
      "SETTING_SHOW_AMPM",
      "SETTING_GEOCODE_ENABLED",
      "SETTING_LOCATION_OVERRIDE",
      "SETTING_USE_STATIC_LOCATION",
      "SETTING_STATIC_LAT",
      "SETTING_STATIC_LON",
      "SETTING_CLEAR_CACHE"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "CARBON_ICONS_12",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        },
        {
          "type": "font",
          "name": "CARBON_ICONS_14",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        },
        {
          "type": "font",
          "name": "CARBON_ICONS_18",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        },
        {
          "type": "font",
          "name": "CARBON_ICONS_22",
          "file": "fonts/IcoMoon-Regular.ttf",
          "characterRegex": "[\\uE000-\\uF9FF]"
        }
      ]
    }
  },
  "scripts": {
    "gen-icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  }
}
